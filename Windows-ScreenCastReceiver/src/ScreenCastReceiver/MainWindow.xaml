<Window x:Class="ScreenCastReceiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xiaolei DLAN" Icon="favicon.png"
        Height="780" Width="1320"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Closed="OnWindowClosed"
        KeyDown="OnWindowKeyDown"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Foreground="#EEFFFFFF">

    <Window.Resources>
        <!-- ========== 液态玻璃主题 ========== -->
        <SolidColorBrush x:Key="GlassTextBrush" Color="#EEFFFFFF"/>
        <SolidColorBrush x:Key="GlassDimBrush" Color="#B0FFFFFF"/>
        <SolidColorBrush x:Key="GlassLineBrush" Color="#4DFFFFFF"/>
        <SolidColorBrush x:Key="GlassFieldBrush" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF00C6FF"/>

        <!-- 玻璃卡片：半透明 + 高光边框 + 悬浮阴影 -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#38FFFFFF" Offset="0"/>
                        <GradientStop Color="#1CFFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#73FFFFFF" Offset="0"/>
                        <GradientStop Color="#2EFFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.30" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 玻璃按钮 -->
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
            <Setter Property="Background" Value="#30FFFFFF"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#45FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主操作按钮：青蓝渐变 + 光晕 -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF00C6FF" Offset="0"/>
                                    <GradientStop Color="#FF0072FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.55" Color="#FF0072FF"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 玻璃输入框 -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Foreground" Value="#F4FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B000C6FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 玻璃下拉框 -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="Foreground" Value="#F4FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4,26,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <ContentPresenter x:Name="ContentSite"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      Margin="{TemplateBinding Padding}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      IsHitTestVisible="False"
                                                      RecognizesAccessKey="True"/>
                                    <ToggleButton x:Name="DropDownToggle" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Width="22" Height="22" Margin="0,0,4,0"
                                                  Background="Transparent" BorderThickness="0"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Background="Transparent">
                                                    <Path x:Name="Arrow" Data="M 0,3 L 6,3 L 3,6 Z" Fill="#F4FFFFFF"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#CC1A2040" BorderBrush="#66FFFFFF" BorderThickness="1"
                                        CornerRadius="10" Padding="4" Effect="{x:Null}">
                                    <ScrollViewer MaxHeight="180">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#9AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B000C6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="#F2FFFFFF"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2,1">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FF00C6FF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <!-- 玻璃复选框 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                    Background="#30FFFFFF" BorderBrush="#8AFFFFFF" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M 3,8 L 7,12 L 13,4"
                                      Stroke="White" StrokeThickness="2" Visibility="Collapsed"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#FF00C6FF"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF00C6FF"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 玻璃单选按钮 -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse x:Name="Outer" Fill="#30FFFFFF" Stroke="#8AFFFFFF" StrokeThickness="1"/>
                                <Ellipse x:Name="Inner" Width="8" Height="8" Fill="#FF00C6FF" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Inner" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Stroke" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 玻璃列表 -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#EFFFFFFF"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 玻璃滑块 -->
        <Style TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="18">
                            <Track x:Name="PART_Track" Orientation="Horizontal">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="Transparent" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#FF00C6FF" CornerRadius="3" Height="6"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="Transparent" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#40FFFFFF" CornerRadius="3" Height="6"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.5" Color="#000000"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分组小标题 -->
        <Style x:Key="GlassSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F6FFFFFF"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- 玻璃分隔线 -->
        <Style x:Key="GlassSeparator" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,6,0,12"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#59FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 深色渐变背景 -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF101D3B" Offset="0"/>
                <GradientStop Color="#FF1F2A55" Offset="0.40"/>
                <GradientStop Color="#FF3A2360" Offset="0.72"/>
                <GradientStop Color="#FF0C1428" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 环境光斑（液态玻璃氛围光） -->
        <Ellipse Width="480" Height="480" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-150,-130,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#52FF9FE0" Offset="0"/>
                    <GradientStop Color="#00FF9FE0" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect><BlurEffect Radius="70"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="440" Height="440" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-120,0,0,-170" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#3C59E9FF" Offset="0"/>
                    <GradientStop Color="#0059E9FF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect><BlurEffect Radius="70"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="140,-90,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#3376E6FF" Offset="0"/>
                    <GradientStop Color="#0076E6FF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect><BlurEffect Radius="60"/></Ellipse.Effect>
        </Ellipse>

        <!-- ========== 左侧玻璃面板 ========== -->
        <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="14,14,0,14" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- 服务控制 -->
                    <TextBlock Text="服务控制面板" Style="{StaticResource GlassSectionTitle}"/>
                    <CheckBox x:Name="ChkDlna" Content="启用 DLNA（APP视频投屏）" FontWeight="SemiBold"
                              Checked="OnDlnaChecked" Unchecked="OnDlnaUnchecked" Margin="0,0,0,10"/>
                    <Grid Margin="20,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="设备名:" Foreground="{StaticResource GlassDimBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtDlnaName" Grid.Column="1" Text="Xiaolei DLAN" TextChanged="OnDlnaNameChanged"/>
                    </Grid>
                    <Grid Margin="20,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="端口:" Foreground="{StaticResource GlassDimBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtDlnaPortInput" Grid.Column="1" Text="0" TextChanged="OnDlnaPortChanged" PreviewTextInput="OnPortPreviewTextInput" MaxLength="5"/>
                        <TextBlock Grid.Column="2" Text="(0=自动)" Foreground="{StaticResource GlassDimBrush}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"/>
                    </Grid>
                    <WrapPanel Orientation="Horizontal" Margin="20,4,0,0">
                        <TextBlock Text="状态:" Foreground="{StaticResource GlassDimBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtDlnaStatus" Text="未启动" Foreground="#FF9AD6FF" Margin="8,0,12,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtDlnaPort" Text="" Foreground="#FF7FE6FF" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal" Margin="20,10,0,0">
                        <TextBlock Text="本机局域网IP:" Foreground="{StaticResource GlassDimBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtLanIp" Text="..." Margin="8,0,10,0" VerticalAlignment="Center" Foreground="#FF8AFFC9" FontWeight="SemiBold"/>
                        <Button Content="刷新" Click="OnRefreshLanIp" Style="{StaticResource GlassButton}" Padding="10,3"/>
                    </WrapPanel>

                    <Grid Margin="20,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ChkHwAccel" Content="硬件加速 (硬解)" FontWeight="SemiBold"
                                  IsChecked="True" Checked="OnHwAccelSwitchChanged" Unchecked="OnHwAccelSwitchChanged"
                                  ToolTip="开启 = 硬解（D3D11VA，降低 CPU 占用）；关闭 = 软解。切换即时生效，不会中断当前投屏"/>
                        <TextBlock x:Name="TxtHwAccelStatus" Grid.Column="1" Text="" Foreground="#FF8AFFC9"
                                   VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </Grid>

                    <Border Style="{StaticResource GlassSeparator}"/>

                    <!-- 网卡绑定 -->
                    <TextBlock Text="网卡绑定（默认全部物理网卡，虚拟网卡手动勾选）" Style="{StaticResource GlassSectionTitle}" TextWrapping="Wrap"/>
                    <TextBlock Text="物理网卡:" Foreground="{StaticResource GlassDimBrush}" Margin="0,0,0,4"/>
                    <ListBox x:Name="LstPhysical" Height="92" SelectionChanged="OnNicSelectionChanged" SelectionMode="Multiple"/>
                    <TextBlock Text="虚拟 / VPN / WSL 网卡:" Foreground="{StaticResource GlassDimBrush}" Margin="0,10,0,4"/>
                    <ListBox x:Name="LstVirtual" Height="70" SelectionChanged="OnNicSelectionChanged" SelectionMode="Multiple"/>

                    <Border Style="{StaticResource GlassSeparator}"/>

                    <!-- 日志 -->
                    <TextBlock Text="日志输出" Style="{StaticResource GlassSectionTitle}"/>
                    <TextBox x:Name="TxtLog" Height="150" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Background="#33000000"
                             FontFamily="Consolas" FontSize="11" Foreground="#D0FFFFFF"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ========== 右侧播放区 ========== -->
        <Grid Grid.Column="1" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 视频画面容器（玻璃屏幕） -->
            <Border Grid.Row="0" Background="#40000000"
                    BorderBrush="#4DFFFFFF" BorderThickness="1" CornerRadius="16"
                    MouseLeftButtonDown="OnVideoMouseLeftButtonDown"
                    ClipToBounds="True">
                <Grid>
                    <Grid x:Name="PlaybackHosts" Background="Black"/>
                    <TextBlock x:Name="TxtNoSignal" Text="等待投屏接入..."
                               FontSize="22" Foreground="#99FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- 悬浮全屏按钮 -->
                    <Button x:Name="BtnFullscreen" Content="⛶ 全屏" Click="OnToggleFullscreen"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                            Style="{StaticResource GlassButton}" Padding="12,6" Opacity="0.72"/>
                </Grid>
            </Border>

            <!-- 播放控制栏（玻璃条） -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" CornerRadius="16" Margin="0,12,0,0" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 进度条 + 时间 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtPos" Text="00:00" Grid.Column="0" Foreground="{StaticResource GlassDimBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="36" TextAlignment="Right"/>
                        <Slider x:Name="SldProgress" Grid.Column="1" Minimum="0" Maximum="100" Value="0"
                                PreviewMouseDown="OnProgressMouseDown" PreviewMouseUp="OnProgressMouseUp"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtDur" Text="00:00" Grid.Column="2" Foreground="{StaticResource GlassDimBrush}"
                                   VerticalAlignment="Center" Margin="10,0,10,0" MinWidth="36"/>
                        <TextBlock x:Name="TxtSpeed" Text="1.0x" Grid.Column="3" Foreground="#FF7FE6FF"
                                   VerticalAlignment="Center" Visibility="Collapsed" FontWeight="SemiBold"/>
                    </Grid>

                    <!-- 控制按钮行 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- 旋转 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                            <TextBlock Text="画面旋转:" Foreground="{StaticResource GlassDimBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <RadioButton x:Name="Rot0" Content="0°" GroupName="Rotation" IsChecked="True" Checked="OnRotationChanged" Margin="0,0,10,0"/>
                            <RadioButton x:Name="Rot90" Content="90°" GroupName="Rotation" Checked="OnRotationChanged" Margin="0,0,10,0"/>
                            <RadioButton x:Name="Rot180" Content="180°" GroupName="Rotation" Checked="OnRotationChanged" Margin="0,0,10,0"/>
                            <RadioButton x:Name="Rot270" Content="270°" GroupName="Rotation" Checked="OnRotationChanged"/>
                        </StackPanel>

                        <Border Width="1" Background="#33FFFFFF" Margin="0,3,18,3"/>

                        <!-- 比例 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                            <TextBlock Text="画面比例:" Foreground="{StaticResource GlassDimBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbAspect" Width="92" SelectionChanged="OnAspectModeChanged">
                                <ComboBoxItem Content="自适应" Tag="fit"/>
                                <ComboBoxItem Content="拉伸" Tag="stretch"/>
                                <ComboBoxItem Content="16:9" Tag="16:9"/>
                                <ComboBoxItem Content="4:3" Tag="4:3"/>
                            </ComboBox>
                        </StackPanel>

                        <Border Width="1" Background="#33FFFFFF" Margin="0,3,18,3"/>

                        <!-- 播放控制 -->
                        <Button x:Name="BtnSeekBackward" Content="◀ 10秒" Click="OnSeekBackward" Style="{StaticResource GlassButton}" Margin="0,0,8,0"/>
                        <Button x:Name="BtnPlayPause" Content="▶" Click="OnTogglePlay" Style="{StaticResource AccentButton}" Width="60" FontSize="14" Margin="0,0,8,0"/>
                        <Button x:Name="BtnSeekForward" Content="10秒 ▶" Click="OnSeekForward" Style="{StaticResource GlassButton}" Margin="0,0,18,0"/>

                        <Border Width="1" Background="#33FFFFFF" Margin="0,3,18,3"/>

                        <CheckBox x:Name="ChkShowSpeed" Content="显示速率" Checked="OnShowSpeedChanged" Unchecked="OnShowSpeedChanged" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
