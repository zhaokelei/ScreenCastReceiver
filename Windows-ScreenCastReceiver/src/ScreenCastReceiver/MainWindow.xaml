<Window x:Class="ScreenCastReceiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenCastReceiver - Windows 投屏接收端"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Closed="OnWindowClosed">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧控制面板 ============ -->
        <Grid Grid.Column="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 服务控制面板（DLNA 服务） -->
            <GroupBox Grid.Row="0" Header="服务控制面板" Margin="0,0,0,8">
                <StackPanel>
                    <!-- DLNA -->
                    <StackPanel Orientation="Horizontal" Margin="2,4">
                        <CheckBox x:Name="ChkDlna" Content="启用DLNA(APP视频投屏)" VerticalAlignment="Center"
                                  Checked="OnDlnaChecked" Unchecked="OnDlnaUnchecked"/>
                        <TextBox x:Name="TxtDlnaName" Width="110" Margin="6,0,0,0" VerticalContentAlignment="Center"
                                 Text="ScreenCastReceiver"
                                 ToolTip="DLNA 设备显示名称，修改后需重启 DLNA 服务生效"
                                 TextChanged="OnDlnaNameChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2,2">
                        <TextBlock Text="状态:" Foreground="Gray"/>
                        <TextBlock x:Name="TxtDlnaStatus" Text="未启动" Foreground="Gray" Margin="4,0,0,0"/>
                        <TextBlock x:Name="TxtDlnaPort" Text="" Foreground="DodgerBlue" Margin="12,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2,2">
                        <TextBlock Text="本机局域网IP:" Foreground="Gray"/>
                        <TextBlock x:Name="TxtLanIp" Text="--" Foreground="Green" Margin="4,0,0,0"/>
                        <Button Content="刷新" Padding="8,0" Margin="12,0,0,0" Click="OnRefreshLanIp"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 网卡选择（需求⑨：物理/虚拟分开展示，默认全部物理） -->
            <GroupBox Grid.Row="1" Header="网卡绑定（默认全部物理网卡，虚拟网卡手动勾选）" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="物理网卡:" FontWeight="Bold" Margin="2,2"/>
                    <ListBox x:Name="LstPhysical" Grid.Row="1" Height="70" SelectionMode="Multiple"
                             SelectionChanged="OnNicSelectionChanged"/>
                    <TextBlock Grid.Row="2" Text="虚拟/VPN/WSL网卡:" FontWeight="Bold" Margin="2,6,2,2"/>
                    <ListBox x:Name="LstVirtual" Grid.Row="2" Height="55" Margin="0,22,0,0" SelectionMode="Multiple"
                             SelectionChanged="OnNicSelectionChanged"/>
                </Grid>
            </GroupBox>

            <!-- 防火墙区域（需求：启动不强弹窗，提示放 UI 面板，不阻塞使用） -->
            <GroupBox Grid.Row="2" Header="防火墙（入站放行，否则手机可能无法连接）" Margin="0,0,0,8">
                <StackPanel>
                    <Button x:Name="BtnFirewall" Content="一键添加防火墙规则(需要管理员权限)" Padding="6,4"
                            Click="OnAddFirewallRule"/>
                    <Button Content="复制 netsh 命令" Padding="6,2" Margin="0,4,0,0" Click="OnCopyFirewallCommand"/>
                    <TextBox x:Name="TxtFirewallCommand" Height="48" Margin="0,4,0,0" IsReadOnly="True"
                             TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                             ToolTip="非管理员模式下，可复制此命令到管理员命令行执行"/>
                </StackPanel>
            </GroupBox>

            <!-- 日志输出（需求⑪：带来源标签） -->
            <GroupBox Grid.Row="3" Header="日志输出" Margin="0,0,0,4">
                <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto"/>
            </GroupBox>
        </Grid>

        <!-- ============ 右侧播放区域 ============ -->
        <Grid Grid.Column="1" Margin="0,8,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 播放窗口区域：DLNA 会话的窗口宿主（会话隔离），仅激活的可见 -->
            <Border Grid.Row="0" BorderBrush="#333" BorderThickness="1" Background="Black">
                <Grid x:Name="PlaybackHosts">
                    <TextBlock x:Name="TxtNoSignal" Text="等待投屏接入..."
                               Foreground="#666" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 画面控制区：旋转按钮（实时旋转画面，不改变窗口大小） + 播放控制 + 进度条 -->
            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="画面旋转:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#555"/>
                    <RadioButton x:Name="Rot0" Content="0°" GroupName="Rotation" IsChecked="True" VerticalAlignment="Center"
                                 Margin="4,0" Checked="OnRotationChanged"/>
                    <RadioButton x:Name="Rot90" Content="90°" GroupName="Rotation" VerticalAlignment="Center"
                                 Margin="4,0" Checked="OnRotationChanged"/>
                    <RadioButton x:Name="Rot180" Content="180°" GroupName="Rotation" VerticalAlignment="Center"
                                 Margin="4,0" Checked="OnRotationChanged"/>
                    <RadioButton x:Name="Rot270" Content="270°" GroupName="Rotation" VerticalAlignment="Center"
                                 Margin="4,0" Checked="OnRotationChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock Text="画面比例:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#555"/>
                    <ComboBox x:Name="CmbAspect" Width="90" VerticalAlignment="Center" SelectionChanged="OnAspectModeChanged">
                        <ComboBoxItem Content="自适应" Tag="fit"/>
                        <ComboBoxItem Content="4:3" Tag="4:3"/>
                        <ComboBoxItem Content="16:9" Tag="16:9"/>
                        <ComboBoxItem Content="拉伸" Tag="stretch"/>
                        <ComboBoxItem Content="平铺" Tag="tile"/>
                        <ComboBoxItem Content="填充" Tag="fill"/>
                    </ComboBox>
                    <CheckBox x:Name="ChkShowSpeed" Content="显示速率" Margin="12,0,0,0" VerticalAlignment="Center" Checked="OnShowSpeedChanged" Unchecked="OnShowSpeedChanged"/>
                    <TextBlock x:Name="TxtSpeed" Text="1.0x" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#555" Visibility="Collapsed"/>
                </StackPanel>

                <!-- 播放控制：快退 / 播放暂停 / 快进 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button x:Name="BtnBackward" Content="◀◀ 10秒" Padding="10,3" Margin="0,0,8,0"
                            ToolTip="快退 10 秒" Click="OnSeekBackward"/>
                    <Button x:Name="BtnPlayPause" Content="▶" Padding="16,3" FontSize="14"
                            ToolTip="播放 / 暂停" Click="OnTogglePlay"/>
                    <Button x:Name="BtnForward" Content="10秒 ▶▶" Padding="10,3" Margin="8,0,0,0"
                            ToolTip="快进 10 秒" Click="OnSeekForward"/>
                </StackPanel>

                <!-- 进度条 + 当前/总时长 -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtPos" Text="00:00" MinWidth="38" TextAlignment="Right"
                               Foreground="#555" VerticalAlignment="Center"/>
                    <Slider x:Name="SldProgress" Grid.Column="1" Minimum="0" Maximum="100" Margin="8,0"
                            VerticalAlignment="Center" IsMoveToPointEnabled="True"
                            PreviewMouseLeftButtonDown="OnProgressMouseDown"
                            PreviewMouseLeftButtonUp="OnProgressMouseUp"/>
                    <TextBlock x:Name="TxtDur" Grid.Column="2" Text="00:00" MinWidth="38"
                               Foreground="#555" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- 底部提示条 -->
            <TextBlock Grid.Row="2" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="2,6,2,0"
                       Text="提示：新投屏接入且已有画面在播放时，会弹窗询问是否抢占。"/>
        </Grid>
    </Grid>
</Window>
