<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 屏幕捕获（MediaProjection） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14 (targetSdk 34) 要求 mediaProjection 前台服务类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- 低版本（Android 8/9）采集系统内部音频失败时的麦克风降级方案 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 13+ 前台服务通知需动态申请 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 网络推流 + 局域网扫描 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 国内 ROM 保活：申请忽略电池优化（配合界面按钮跳转系统设置） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenPush">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 推流前台服务：Android 14 要求声明 mediaProjection 类型 -->
        <service
            android:name=".ScreenPushService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>

</manifest>
